<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.firewall.app.tests">

    <uses-permission android:name="org.lineageos.firewall.permission.MANAGE_FIREWALL" />
    <!-- To find apps sharing a uid. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application>
        <!-- Sees the firewall app's notifications once the test allows it, as CTS does. -->
        <service
            android:name="org.lineageos.firewall.NotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="org.lineageos.firewall.app.tests" />
</manifest>
