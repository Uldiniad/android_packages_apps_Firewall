<!-- An app without INTERNET, which the firewall starts blocked when it's newly installed. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.firewall.hostside.nointernet">

    <application android:hasCode="false">
        <!-- A launcher entry with no code behind it, which archiving needs. -->
        <activity
            android:name=".NoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
