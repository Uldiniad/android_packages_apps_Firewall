<!-- Soong's generated test config, with the app without INTERNET the tests need. -->
<configuration description="Runs FirewallAppTests.">
    <option name="test-suite-tag" value="apct" />
    <option name="test-suite-tag" value="apct-instrumentation" />
    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <option name="test-file-name" value="FirewallAppTests.apk" />
        <option name="test-file-name" value="FirewallNoInternetTestApp.apk" />
    </target_preparer>
    <test class="com.android.tradefed.testtype.AndroidJUnitTest" >
        <option name="package" value="org.lineageos.firewall.app.tests" />
        <option name="runner" value="androidx.test.runner.AndroidJUnitRunner" />
    </test>
</configuration>
