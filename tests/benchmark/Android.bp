cc_benchmark {
    name: "firewall_benchmark",
    srcs: ["firewall_benchmark.cpp"],
    require_root: true,
    header_libs: [
        "bpf_syscall_wrappers",
        "firewall_headers",
    ],
    static_libs: [
        "libfirewall_lookup",
        "libnetd_test_tun_interface",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
        "libnetutils",
    ],
}
