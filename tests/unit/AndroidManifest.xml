<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.firewall.tests">

    <!-- if_nametoindex() needs a socket. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The app without INTERNET installed beside this one. -->
    <queries>
        <package android:name="org.lineageos.firewall.hostside.nointernet" />
    </queries>

    <application />

    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="org.lineageos.firewall.tests" />
</manifest>
