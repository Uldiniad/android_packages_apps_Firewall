<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Summary of an app blocked, or allowed, for a while, or blocked by its schedule now. -->
    <string name="rules_blocked_until">Blocked until <xliff:g id="time" example="14:30">%1$s</xliff:g></string>
    <string name="rules_allowed_until">Allowed until <xliff:g id="time" example="14:30">%1$s</xliff:g></string>
    <string name="rules_blocked_schedule">Blocked on a schedule</string>
    <!-- Blocks the app, or allows it, for a while, over its switch and schedule; with how long. -->
    <string name="pause_block_title">Block for a while</string>
    <string name="pause_allow_title">Allow for a while</string>
    <string name="pause_off">Off</string>
    <string name="pause_until">Until <xliff:g id="time" example="14:30">%1$s</xliff:g></string>
    <string name="pause_15_minutes">15 minutes</string>
    <string name="pause_1_hour">1 hour</string>
    <string name="pause_8_hours">8 hours</string>
    <!-- Opens the app's weekly schedule, during which it is blocked; its summary when off and on. -->
    <string name="schedule_title">Block on a schedule</string>
    <string name="schedule_off">Off</string>
    <string name="schedule_switch">Use schedule</string>
    <string name="schedule_summary"><xliff:g id="days" example="Mon, Tue">%1$s</xliff:g>, <xliff:g id="start" example="22:00">%2$s</xliff:g>–<xliff:g id="end" example="07:00">%3$s</xliff:g></string>
    <string name="schedule_start">Start</string>
    <string name="schedule_end">End</string>
    <string name="schedule_days">Days</string>
    <string name="schedule_footer">The app is blocked from the start to the end on each day you choose. An end before the start is the next morning.</string>
</resources>
